// Cloudflare Worker for the web app (built by @opennextjs/cloudflare: `npm run cf:deploy`).
// Runtime values (never in this file): ALCHEMY_RH_MAINNET_URL, ALCHEMY_RH_TESTNET_URL, set in the dashboard or with `npx wrangler secret put`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "offmint-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "offmint-web" }],
  // /api/rpc per-IP limit (src/lib/rateLimit.ts RPC_LIMIT must match)
  "ratelimits": [{ "name": "RPC_LIMITER", "namespace_id": "4663001", "simple": { "limit": 120, "period": 60 } }],
  // runtime variables set in the dashboard (the Alchemy URLs) survive `wrangler deploy`; they are never in this file
  "keep_vars": true,
  "observability": { "enabled": true }
}
