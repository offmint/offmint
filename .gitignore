# Markdown outside docs/ stays local (e.g. CLAUDE.md); the public README and everything in docs/ are tracked
# (plans, decisions, verification reports, claims ledger, threat model: recoverable and visible to judges)
*.md
!README.md
!docs/**/*.md

# Secrets
.env
.env.*
!.env.example

# Foundry
contracts/out/
contracts/cache/
contracts/broadcast/*/*/dry-run/
contracts/broadcast/**/run-latest.json

# Node
node_modules/
.next/
.next-*/
dist/
*.tsbuildinfo

# Keeper runtime
keeper/logs/

# OS / editor
.DS_Store
.vscode/
.idea/

# local anvil deployments (testnet/mainnet deployment files ARE committed)
contracts/deployments/31337.json

# forge script preprocessor scratch
contracts/foundry-pp/
# local anvil broadcasts (testnet/mainnet broadcast logs ARE committed as deploy evidence)
contracts/broadcast/**/31337/

# screening cache
backtest/.cache/

# detector log cache (large, rebuilt incrementally)
contracts/config/.detector-cache.json

# Cloudflare (OpenNext build output, local wrangler state, local secrets)
web/.open-next/
web/.wrangler/
.dev.vars
